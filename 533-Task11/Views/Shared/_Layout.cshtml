<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital_System</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_533_Task11.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <br />
    <br />
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top py-3">
            <div class="container">

                <a class="navbar-brand fw-bold" href="/Home/Index">
                    <i class="bi bi-hospital me-2"></i>
                    Hospital System
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <div class="ms-auto d-flex gap-2 mt-3 mt-lg-0">

                        <a href="~/Doctor/Index"
                           class="btn btn-light text-primary">
                            <i class="bi bi-calendar-plus me-1"></i>
                            Book Appointment
                        </a>

                        <a href="/Appointment/Index"
                           class="btn btn-outline-light">
                            <i class="bi bi-calendar-check me-1"></i>
                            All Appointments
                        </a>

                    </div>
                </div>
            </div>
        </nav>
    </header>
    <br />
    @* Body *@
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    @* Body *@

    <!-- Footer -->
<footer class="bg-dark text-white text-center py-4 ">
    <div class="container">
        <p class="mb-0">
            &copy; 2026 Hospital System
        </p>
    </div>
</footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
