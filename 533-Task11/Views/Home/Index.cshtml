
@{
    ViewData["Title"] = "Hospital System";
}

<!-- Hero Section -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center g-5">

            <!-- Text -->
            <div class="col-lg-6">

                <span class="badge bg-primary-subtle text-primary px-3 py-2 mb-3">
                    <i class="bi bi-heart-pulse me-1"></i>
                    Healthcare You Can Trust
                </span>

                <h1 class="display-4 fw-bold text-dark">
                    Your Health,
                    <span class="text-primary">Our Priority</span>
                </h1>

                <p class="lead text-secondary mt-3">
                    Welcome to Hospital System.
                    Book your appointment easily and manage
                    all your appointments in one place.
                </p>

                <div class="d-flex flex-wrap gap-3 mt-4">

                    <a href="/Doctor/Index"
                       class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-calendar-plus me-2"></i>
                        Book Appointment
                    </a>

                    <a href="/Appointment/Index"
                       class="btn btn-outline-primary btn-lg px-4">
                        <i class="bi bi-calendar-check me-2"></i>
                        All Appointments
                    </a>

                </div>

            </div>


            <!-- Hospital Image -->
            <div class="col-lg-6">

                <div class="position-relative">

                    <img src="https://images.unsplash.com/photo-1586773860418-d37222d8fce3?auto=format&fit=crop&w=1200&q=85"
                         class="img-fluid rounded-4 shadow-lg w-100"
                         alt="Modern Hospital">

                    <!-- Floating Card -->
                    <div class="position-absolute bottom-0 start-0
                                bg-white shadow rounded-3 p-3 m-3">

                        <div class="d-flex align-items-center">

                            <div class="bg-primary text-white rounded-circle
                                        d-flex align-items-center justify-content-center"
                                 style="width:50px;height:50px;">

                                <i class="bi bi-shield-check fs-4"></i>

                            </div>

                            <div class="ms-3">
                                <h6 class="mb-0 fw-bold">
                                    Quality Healthcare
                                </h6>

                                <small class="text-muted">
                                    Care you can trust
                                </small>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>
</section>


<!-- Services Section -->
<section class="py-5 bg-light">

    <div class="container">

        <div class="text-center mb-5">

            <span class="text-primary fw-semibold">
                OUR SERVICES
            </span>

            <h2 class="fw-bold mt-2">
                Healthcare Made Simple
            </h2>

            <p class="text-muted">
                Everything you need to manage your appointments easily.
            </p>

        </div>


        <div class="row g-4">

            <!-- Card 1 -->
            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100 text-center p-4">

                    <div class="mx-auto bg-primary-subtle text-primary
                                rounded-circle d-flex align-items-center
                                justify-content-center mb-3"
                         style="width:70px;height:70px;">

                        <i class="bi bi-calendar-plus fs-2"></i>

                    </div>

                    <h5 class="fw-bold">
                        Easy Booking
                    </h5>

                    <p class="text-muted mb-0">
                        Book your hospital appointment quickly
                        and easily.
                    </p>

                </div>

            </div>


            <!-- Card 2 -->
            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100 text-center p-4">

                    <div class="mx-auto bg-primary-subtle text-primary
                                rounded-circle d-flex align-items-center
                                justify-content-center mb-3"
                         style="width:70px;height:70px;">

                        <i class="bi bi-calendar-check fs-2"></i>

                    </div>

                    <h5 class="fw-bold">
                        Manage Appointments
                    </h5>

                    <p class="text-muted mb-0">
                        View and manage all your appointments
                        in one place.
                    </p>

                </div>

            </div>


            <!-- Card 3 -->
            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100 text-center p-4">

                    <div class="mx-auto bg-primary-subtle text-primary
                                rounded-circle d-flex align-items-center
                                justify-content-center mb-3"
                         style="width:70px;height:70px;">

                        <i class="bi bi-heart-pulse fs-2"></i>

                    </div>

                    <h5 class="fw-bold">
                        Patient Care
                    </h5>

                    <p class="text-muted mb-0">
                        We make healthcare management simple
                        and convenient.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

